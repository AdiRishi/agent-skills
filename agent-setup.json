{
  "$schema": "./agent-setup.schema.json",
  "schemaVersion": 1,
  "installer": {
    "package": "skills",
    "version": "1.5.23"
  },
  "sharedSkillsDirectory": "~/.agents/skills",
  "stateFile": "~/.config/agent-skills/state.json",
  "defaultHarnesses": [
    "claude-code",
    "codex"
  ],
  "harnesses": {
    "claude-code": {
      "installerAgent": "claude-code",
      "skillsDirectory": "~/.claude/skills",
      "readsSharedSkills": false,
      "globalInstructions": "~/.claude/CLAUDE.md",
      "check": {
        "command": "claude",
        "args": [
          "--version"
        ]
      }
    },
    "codex": {
      "installerAgent": "codex",
      "skillsDirectory": "~/.codex/skills",
      "readsSharedSkills": true,
      "globalInstructions": "~/.codex/AGENTS.md",
      "check": {
        "command": "codex",
        "args": [
          "--version"
        ]
      }
    }
  },
  "requirements": {
    "codex-mcp": {
      "description": "Claude Code can reach Codex through its MCP server",
      "requiredBy": [
        "invoke-codex"
      ],
      "check": {
        "command": "claude",
        "args": [
          "mcp",
          "get",
          "codex"
        ],
        "outputIncludes": [
          "Status: ✔ Connected",
          "Command: codex",
          "Args: mcp-server",
          "Scope: User config"
        ]
      },
      "apply": {
        "command": "claude",
        "args": [
          "mcp",
          "add",
          "--scope",
          "user",
          "codex",
          "--",
          "codex",
          "mcp-server"
        ]
      }
    }
  },
  "globalInstructions": {
    "source": "global/AGENTS.md"
  },
  "sources": {
    "mattpocock-skills": {
      "repo": "https://github.com/mattpocock/skills",
      "ref": "main",
      "author": "Matt Pocock",
      "license": "MIT",
      "licenseFile": "licenses/mattpocock-skills-MIT.txt",
      "upstreamLicensePath": "LICENSE"
    },
    "pstack": {
      "repo": "https://github.com/cursor/plugins",
      "ref": "main",
      "author": "Lauren Tan",
      "license": "MIT",
      "licenseFile": "licenses/pstack-MIT.txt",
      "upstreamLicensePath": "pstack/LICENSE"
    }
  },
  "skills": {
    "codebase-design": {
      "origin": "vendored",
      "source": "mattpocock-skills",
      "path": "skills/engineering/codebase-design",
      "vendoredFrom": "1bb95954ef0d06ba4d64a9c267fb75f57c614a1f",
      "modified": false
    },
    "engineering-principles": {
      "origin": "custom",
      "author": "Adishwar Rishi",
      "license": "MIT"
    },
    "invoke-codex": {
      "origin": "custom",
      "author": "Adishwar Rishi",
      "license": "MIT",
      "harnesses": [
        "claude-code"
      ]
    },
    "technical-writing": {
      "origin": "vendored",
      "source": "pstack",
      "path": "pstack/skills/technical-writing",
      "vendoredFrom": "60c641e4fad674784b30abcf9f8915dea39df38d",
      "modified": true,
      "note": "Removed disable-model-invocation from SKILL.md so the model can invoke it. Keep it removed during an update.",
      "localFiles": [
        "agents/openai.yaml"
      ]
    },
    "typescript-best-practices": {
      "origin": "vendored",
      "source": "pstack",
      "path": "pstack/skills/typescript-best-practices",
      "vendoredFrom": "60c641e4fad674784b30abcf9f8915dea39df38d",
      "modified": false,
      "localFiles": [
        "agents/openai.yaml"
      ]
    },
    "unslop": {
      "origin": "vendored",
      "source": "pstack",
      "path": "pstack/skills/unslop",
      "vendoredFrom": "60c641e4fad674784b30abcf9f8915dea39df38d",
      "modified": false,
      "localFiles": [
        "agents/openai.yaml"
      ]
    },
    "writing-for-agents": {
      "origin": "vendored",
      "source": "mattpocock-skills",
      "path": "skills/productivity/writing-for-agents",
      "vendoredFrom": "1bb95954ef0d06ba4d64a9c267fb75f57c614a1f",
      "modified": false
    },
    "wayfinder": {
      "origin": "vendored",
      "source": "mattpocock-skills",
      "path": "skills/engineering/wayfinder",
      "vendoredFrom": "885e2ca4d842d139e9aef4e48d366c63cb1b8013",
