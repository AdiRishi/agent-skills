{
  "$schema": "./agent-setup.schema.json",
  "schemaVersion": 1,
  "installer": {
    "package": "skills",
    "version": "1.5.23"
  },
  "sharedSkillsDirectory": "~/.agents/skills",
  "stateFile": "~/.config/agent-skills/state.json",
  "defaultHarnesses": [
    "claude-code",
    "codex"
  ],
  "harnesses": {
    "claude-code": {
      "installerAgent": "claude-code",
      "skillsDirectory": "~/.claude/skills",
      "readsSharedSkills": false,
      "globalInstructions": "~/.claude/CLAUDE.md",
      "check": {
        "command": "claude",
        "args": [
          "--version"
        ]
      }
    },
    "codex": {
      "installerAgent": "codex",
      "skillsDirectory": "~/.codex/skills",
      "readsSharedSkills": true,
      "globalInstructions": "~/.codex/AGENTS.md",
      "check": {
        "command": "codex",
        "args": [
          "--version"
        ]
      }
    },
    "cursor": {
      "installerAgent": "cursor",
      "skillsDirectory": "~/.cursor/skills",
      "readsSharedSkills": true,
      "globalInstructions": "~/.cursor/AGENTS.md",
      "check": {
        "command": "cursor",
        "args": [
          "--version"
        ]
      }
    }
  },
  "requirements": {
    "codex-mcp": {
      "description": "Claude Code can reach Codex through its MCP server",
      "requiredBy": [
        "invoke-codex"
      ],
      "check": {
        "command": "claude",
        "args": [
          "mcp",
          "get",
          "codex"
        ],
        "outputIncludes": [
          "Status: ✔ Connected",
          "Command: codex",
          "Args: mcp-server",
          "Scope: User config"
        ]
      },
      "apply": {
        "command": "claude",
        "args": [
          "mcp",
          "add",
          "--scope",
          "user",
          "codex",
          "--",
          "codex",
          "mcp-server"
        ]
      }
    }
  },
  "globalInstructions": {
    "source": "global/AGENTS.md",
    "harnessSections": {
      "codex": "global/codex.md"
    }
  },
  "sources": {
    "mattpocock-skills": {
      "repo": "https://github.com/mattpocock/skills",
      "ref": "main",
      "author": "Matt Pocock",
      "license": "MIT",
      "licenseFile": "licenses/mattpocock-skills-MIT.txt",
      "upstreamLicensePath": "LICENSE"
    },
    "pstack": {
      "repo": "https://github.com/cursor/plugins",
      "ref": "main",
      "author": "Lauren Tan",
      "license": "MIT",
      "licenseFile": "licenses/pstack-MIT.txt",
      "upstreamLicensePath": "pstack/LICENSE"
    },
    "pr-review-canvas": {
      "repo": "https://github.com/cursor/plugins",
      "ref": "main",
      "author": "Cursor",
      "license": "MIT",
      "licenseFile": "licenses/pr-review-canvas-MIT.txt",
      "upstreamLicensePath": "pr-review-canvas/LICENSE"
    }
  },
  "skills": {
    "code-review-canvas": {
      "origin": "vendored",
      "source": "pr-review-canvas",
      "path": "pr-review-canvas/skills/pr-review-canvas",
      "vendoredFrom": "7314f723a487ec406b6369fe5865ba034cfed166",
      "modified": true,
      "note": "Renamed the skill from pr-review-canvas to code-review-canvas, set disable-model-invocation so it runs only when named, retargeted it from a GitHub PR to the local branch vs the default branch, and required technical-writing and unslop for canvas copy. Keep these during an update.",
      "harnesses": [
        "cursor"
      ],
      "allowModelInvocation": false
    },
    "codebase-design": {
      "origin": "vendored",
